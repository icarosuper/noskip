# Copy to .env.local and fill in. .env.local is gitignored.

# Postgres — matches docker-compose.yml
DATABASE_URL="postgresql://noskip:noskip@localhost:5432/noskip"

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# OAuth apps — how to create them: docs/guides/development.md
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
